APP_ENV=dev
APP_SECRET_KEY=change-me-in-production-please-use-long-random-string
# Default: SQLite for native local dev (no external services needed).
DATABASE_URL=sqlite+aiosqlite:///./atlas.db
# Postgres for docker-compose / production:
# DATABASE_URL=postgresql+asyncpg://atlas:atlas@db:5432/atlas
REDIS_URL=redis://localhost:6379/0

# LLM provider: openai | anthropic | mock (default when no keys)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Live web search for real supplier discovery.
# Get one free at https://tavily.com (1000 searches/month on free tier).
# With a key set, AI Discover returns real companies; without, it falls back
# to offline LLM-only synthesis.
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=10

# Second web-search provider: DuckDuckGo HTML (no key, no signup).
# Runs in parallel with Tavily; results are merged + deduped by URL.
# Set false if outbound DDG traffic is blocked in your environment.
DDG_SEARCH_ENABLED=true
DDG_MAX_RESULTS=10

# After discovery, fetch each supplier's homepage + /contact page to
# extract real email/phone from the static HTML. Disable if outbound
# web traffic is blocked in your env.
SITE_CRAWLER_ENABLED=true
SITE_CRAWLER_MAX_PER_DISCOVERY=8

# --- Gmail: the customer-facing integration -------------------------------
# Google OAuth 2.0. Each user connects their own mailbox. Leave the flag false
# until credentials exist: with it off, drafts are recorded but never sent, and
# no Connect button is offered. See docs/gmail-oauth-setup.md.
GMAIL_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the Authorised redirect URI in Google Cloud character for
# character — same scheme, no trailing slash.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# Protects OAuth refresh tokens at rest. Required before anyone can connect.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this invalidates every stored connection; users must reconnect.
TOKEN_ENCRYPTION_KEY=

# --- Gmail: development / administrator fallback ---------------------------
# SMTP + IMAP with an App Password. Authenticates ONE shared mailbox, so it
# cannot serve multiple customers — use OAuth above for that. Requires 2-Step
# Verification, an App Password from https://myaccount.google.com/apppasswords
# (16 chars, no spaces), and IMAP enabled in Gmail settings.
# Left empty, the whole email flow runs OFFLINE: drafts are recorded, nothing
# is transmitted, reply-sync is a no-op.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=Atlas Trade Desk
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_LOOKBACK_DAYS=14

# CORS
CORS_ORIGINS=http://localhost:3000

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
