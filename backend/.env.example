APP_ENV=dev
APP_SECRET_KEY=change-me-in-production-please-use-long-random-string
# Default: SQLite for native local dev (no external services needed).
DATABASE_URL=sqlite+aiosqlite:///./atlas.db
# Postgres for docker-compose / production:
# DATABASE_URL=postgresql+asyncpg://atlas:atlas@db:5432/atlas
REDIS_URL=redis://localhost:6379/0

# LLM provider: openai | anthropic | mock (default when no keys)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Live web search for real supplier discovery.
# Get one free at https://tavily.com (1000 searches/month on free tier).
# With a key set, AI Discover returns real companies; without, it falls back
# to offline LLM-only synthesis.
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=10

# Second web-search provider: DuckDuckGo HTML (no key, no signup).
# Runs in parallel with Tavily; results are merged + deduped by URL.
# Set false if outbound DDG traffic is blocked in your environment.
DDG_SEARCH_ENABLED=true
DDG_MAX_RESULTS=10

# After discovery, fetch each supplier's homepage + /contact page to
# extract real email/phone from the static HTML. Disable if outbound
# web traffic is blocked in your env.
SITE_CRAWLER_ENABLED=true
SITE_CRAWLER_MAX_PER_DISCOVERY=8

# Gmail execution channel — send outreach via SMTP + read replies via IMAP.
# Uses a Gmail App Password (NOT your normal password): turn on 2-Step
# Verification, then generate one at https://myaccount.google.com/apppasswords
# and also enable IMAP in Gmail (Settings > Forwarding and POP/IMAP).
# Leave GMAIL_ADDRESS / GMAIL_APP_PASSWORD empty to run OFFLINE (emails are
# recorded but not transmitted; reply-sync is a no-op).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Optional display name shown on outbound mail, e.g. "Atlas Trade Desk".
GMAIL_FROM_NAME=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# How many days back to scan the inbox when syncing replies.
IMAP_LOOKBACK_DAYS=14

# CORS
CORS_ORIGINS=http://localhost:3000

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
